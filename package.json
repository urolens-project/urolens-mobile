{
  "name": "urolens-mobile",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "bash scripts/run-ios-device.sh",
    "test": "jest --watchAll=false",
    "test:ci": "jest --watchAll=false --coverage",
    "test:coverage": "jest --watchAll=false --coverage",
    "test:watch": "jest --watchAll",
    "type-check": "tsc --noEmit",
    "lint": "eslint src app --ext .ts,.tsx",
    "generate:types": "openapi-typescript http://localhost:8000/openapi.json -o src/types/api.ts",
    "build:preview": "eas build --profile preview --platform all"
  },
  "dependencies": {
    "@abraham/reflection": "^0.13.0",
    "@expo/metro-runtime": "^55.0.11",
    "@expo/vector-icons": "^15.1.1",
    "@nozbe/watermelondb": "^0.28.0",
    "@nozbe/with-observables": "^1.6.0",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-community/netinfo": "^11.5.2",
    "@react-navigation/native": "~7.1.33",
    "axios": "^1.9.0",
    "expo": "~55.0.26",
    "expo-camera": "~55.0.19",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.35",
    "expo-device": "~55.0.17",
    "expo-file-system": "^56.0.7",
    "expo-font": "~55.0.8",
    "expo-image-manipulator": "~55.0.17",
    "expo-image-picker": "~55.0.20",
    "expo-linking": "~55.0.15",
    "expo-network": "~55.0.14",
    "expo-notifications": "~55.0.23",
    "expo-router": "~55.0.16",
    "expo-secure-store": "~55.0.14",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-web-browser": "~55.0.16",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "~0.7.4",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@babel/plugin-transform-class-properties": "^7.28.6",
    "@babel/plugin-transform-private-methods": "^7.28.6",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.9.1",
    "@types/react": "~19.2.15",
    "babel-plugin-transform-typescript-metadata": "^0.4.0",
    "eslint": "^9.26.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.18",
    "openapi-typescript": "^7.8.0",
    "prettier": "^3.5.3",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/tests"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect",
      "<rootDir>/tests/setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(\\.pnpm|(?:jest-)?react-native|@react-native(?:-community)?|expo(?:nent)?|@expo(?:nent)?/|@expo-google-fonts/|react-navigation|@react-navigation/|@unimodules/|unimodules|sentry-expo|native-base|react-native-svg|@nozbe/watermelondb))"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80
      }
    },
    "collectCoverageFrom": [
      "src/db/sync/conflictResolver.ts",
      "src/lib/auth/tokenStorage.ts",
      "src/lib/camera/imageUtils.ts",
      "src/features/image-retake/hooks/useImageRetake.ts",
      "src/features/queue/hooks/useQueue.ts",
      "src/features/specimen-rejection/hooks/useRejectSpecimen.ts"
    ],
    "moduleNameMapper": {
      "^@app-types/(.*)$": "<rootDir>/src/types/$1",
      "^@lib/(.*)$": "<rootDir>/src/lib/$1",
      "^@db/(.*)$": "<rootDir>/src/db/$1",
      "^@features/(.*)$": "<rootDir>/src/features/$1",
      "^@components/(.*)$": "<rootDir>/src/components/$1",
      "^@hooks/(.*)$": "<rootDir>/src/hooks/$1",
      "^@mocks/(.*)$": "<rootDir>/src/mocks/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@nozbe/watermelondb",
          "@nozbe/simdjson"
        ]
      }
    },
    "install": {
      "exclude": [
        "@react-navigation/native"
      ]
    }
  },
  "pnpm": {
    "overrides": {
      "@react-navigation/native": "7.1.33"
    }
  },
  "private": true
}